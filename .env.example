# Copy to .env and fill in real values. This file is committed; .env is not.

# Redbark API key. Live keys are prefixed rbk_live_.
REDBARK_API_KEY=rbk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redbark API base URL. Only set this to point at a sandbox or a mock; the
# default is the production API.
#REDBARK_API_URL=https://api.redbark.com

# Anthropic API key, optional. Powers merchant identification only (lookup
# agent, identity sweep, classifier, propagation); every deterministic
# feature runs without it. The admin panel can also save it here for you,
# after checking it against the API.
#ANTHROPIC_API_KEY=sk-ant-<paste your key here>

# Backups: consistent snapshots into data/backups/ at startup and on a
# timer. 0 disables. Optional mirror folder gets a copy of each snapshot
# (point it at a synced folder for off-machine protection).
#SPENDGLASS_BACKUP_INTERVAL_HOURS=24
#SPENDGLASS_BACKUP_KEEP=10
#SPENDGLASS_BACKUP_MIRROR_DIR=/path/to/synced/folder/spendglass-backups
